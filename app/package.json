{
  "name": "eks-app",
  "version": "0.1.0",
  "description": "Production-grade order-processing REST API deployed on AWS EKS",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev":   "nodemon src/server.js",
    "test":  "jest --runInBand --forceExit --detectOpenHandles",
    "lint":  "eslint src/"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv":      "^16.3.1",
    "express":     "^4.18.2",
    "pg":          "^8.10.0",
    "pino":        "^8.20.0",
    "prom-client": "^14.2.0"
  },
  "devDependencies": {
    "eslint":   "^8.50.0",
    "jest":     "^29.0.0",
    "nodemon":  "^3.0.1",
    "supertest":"^6.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.js"]
  }
}
