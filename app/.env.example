# ============================================================
# Environment variable reference.
# Copy this file to .env for local development:
#   cp .env.example .env
#
# In Kubernetes these are injected automatically from the
# ConfigMap (non-sensitive) and a Secret (PGPASSWORD).
# ============================================================

# Application
PORT=8080
LOG_LEVEL=info    # debug | info | warn | error

# PostgreSQL connection — must match your local docker-compose values
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=ordersdb
